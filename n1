import { useState } from "react";

export default function Pest() {
  const [file, setFile] = useState(null);
  const [result, setResult] = useState("");

  const handleUpload = async (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append("image", file);

    const res = await fetch("http://localhost:5000/api/pest/upload", {
      method: "POST",
      body: formData,
    });

    const data = await res.json();
    setResult(data.diagnosis);
  };

  return (
    <div className="p-8">
      <h2 className="text-xl font-semibold mb-4">📸 Upload Crop Image for Pest Detection</h2>
      
      <form onSubmit={handleUpload} className="space-y-4">
        <input type="file" onChange={(e) => setFile(e.target.files[0])} required />
        <button className="px-4 py-2 bg-green-600 text-white rounded-lg" type="submit">Upload</button>
      </form>

      {result && (
        <div className="mt-6 p-4 border rounded-lg bg-gray-100">
          <p className="font-bold text-gray-700">AI Diagnosis:</p>
          <p>{result}</p>
        </div>
      )}
    </div>
  );
}
